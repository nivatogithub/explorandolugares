    "history": {
      "es": [
        "Santa Marta, fundada en 1525, conserva en su centro la huella del puerto colonial. La Catedral y la Casa de la Aduana dialogan con el patrimonio indígena de la Sierra Nevada. En la Quinta de San Pedro Alejandrino murió Simón Bolívar en 1830."
      ],
      "en": [
        "Founded in 1525, Santa Marta retains traces of its colonial port in the historic centre. The Cathedral and Customs House sit alongside the Indigenous heritage of the Sierra Nevada. Simón Bolívar died at the Quinta de San Pedro Alejandrino in 1830."
      ],
      "pt-BR": [
        "Fundada em 1525, Santa Marta conserva no centro as marcas do porto colonial. A Catedral e a Casa da Aduana convivem com o patrimônio indígena da Sierra Nevada. Simón Bolívar morreu na Quinta de San Pedro Alejandrino em 1830."
      ]
    },
    "reasons": {
      "es": [
        "Combina playas caribeñas y montaña.",
        "Recorre historia, patrimonio y vida urbana.",
        "Conoce bahías con identidad propia.",
        "Descubre el café y las aves de la Sierra."
      ],
      "en": [
        "Combine Caribbean beaches and mountains.",
        "Explore history, heritage and urban life.",
        "Visit bays with their own identities.",
        "Discover the Sierra’s coffee and birdlife."
      ],
      "pt-BR": [
        "Combine praias caribenhas e montanha.",
        "Explore história, patrimônio e vida urbana.",
        "Conheça baías com identidade própria.",
        "Descubra o café e as aves da Sierra."
      ]
    },
