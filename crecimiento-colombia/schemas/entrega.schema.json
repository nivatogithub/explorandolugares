{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explorandolugares.com/schemas/crecimiento/v1/entrega.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "place_id": {
      "type": "string",
      "minLength": 1
    },
    "worker": {
      "enum": [
        "fuentes",
        "fotos-reales",
        "conversion",
        "redaccion",
        "traduccion",
        "negocios",
        "integracion",
        "qa"
      ]
    },
    "base_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "draft",
        "review",
        "accepted",
        "blocked"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "minLength": 1
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reuse_status": {
            "enum": [
              "allowed",
              "restricted",
              "pending"
            ]
          }
        },
        "required": [
          "url",
          "entity",
          "checked_at",
          "claims",
          "reuse_status"
        ],
        "additionalProperties": false
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "cover",
              "history",
              "attraction",
              "experience"
            ]
          },
          "place_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "license_url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "permission_evidence": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "minLength": 1
          },
          "commercial_use_allowed": {
            "type": "boolean"
          },
          "transformations_allowed": {
            "type": "boolean"
          },
          "modifications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "credit": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "object",
            "properties": {
              "es": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              },
              "pt-BR": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "es",
              "en",
              "pt-BR"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "role",
          "place_id",
          "subject_id",
          "author",
          "source_url",
          "license",
          "license_url",
          "permission_evidence",
          "checked_at",
          "commercial_use_allowed",
          "transformations_allowed",
          "modifications",
          "credit",
          "alt"
        ],
        "additionalProperties": false
      }
    },
    "business_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "place_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "checked_at": {
            "type": "string",
            "minLength": 1
          },
          "public_listing": {
            "enum": [
              "draft",
              "public"
            ]
          },
          "data_verification": {
            "enum": [
              "pending",
              "corroborated"
            ]
          },
          "claim_status": {
            "enum": [
              "unclaimed",
              "pending",
              "accepted",
              "disputed"
            ]
          },
          "identity_status": {
            "enum": [
              "pending",
              "checked"
            ]
          },
          "representation_status": {
            "enum": [
              "pending",
              "checked",
              "revoked"
            ]
          },
          "legal_status": {
            "enum": [
              "unknown",
              "checked",
              "not_applicable"
            ]
          },
          "rnt_status": {
            "enum": [
              "unknown",
              "checked",
              "not_applicable"
            ]
          },
          "operating_status": {
            "enum": [
              "unknown",
              "open",
              "temporarily_closed",
              "closed"
            ]
          },
          "alliance_status": {
            "enum": [
              "none",
              "agreement_confirmed"
            ]
          },
          "verification_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "place_ids",
          "name",
          "category",
          "source_url",
          "checked_at",
          "public_listing",
          "data_verification",
          "claim_status",
          "identity_status",
          "representation_status",
          "legal_status",
          "rnt_status",
          "operating_status",
          "alliance_status",
          "verification_evidence"
        ],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "place_id",
    "worker",
    "base_hash",
    "status",
    "artifacts",
    "sources",
    "photos",
    "business_records",
    "blockers",
    "reviewer"
  ],
  "additionalProperties": false
}
