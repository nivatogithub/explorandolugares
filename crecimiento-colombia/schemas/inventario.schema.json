{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explorandolugares.com/schemas/crecimiento/v1/inventario.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "universe_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "curated_candidates_not_all_municipalities"
    },
    "score_weights": {
      "type": "object",
      "properties": {
        "reuse": {
          "type": "integer"
        },
        "sources": {
          "type": "integer"
        },
        "editorial": {
          "type": "integer"
        },
        "rights": {
          "type": "integer"
        },
        "operations": {
          "type": "integer"
        }
      },
      "required": [
        "reuse",
        "sources",
        "editorial",
        "rights",
        "operations"
      ],
      "additionalProperties": false
    },
    "departments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "score_inputs": {
            "type": "object",
            "properties": {
              "reuse": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "sources": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "editorial": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "rights": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "operations": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            },
            "required": [
              "reuse",
              "sources",
              "editorial",
              "rights",
              "operations"
            ],
            "additionalProperties": false
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "priority": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "weight": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "editorial_estimate",
              "measured"
            ]
          },
          "unit_type": {
            "enum": [
              "department",
              "capital_district"
            ]
          },
          "dane_code": {
            "type": "string",
            "minLength": 1
          },
          "places": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "slug": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "municipality",
                    "district",
                    "corregimiento",
                    "autonomous_destination"
                  ]
                },
                "parent_place_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dane_code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "administrative_identity_status": {
                  "enum": [
                    "pending_verification",
                    "verified"
                  ]
                },
                "score_inputs": {
                  "type": "object",
                  "properties": {
                    "reuse": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "sources": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "editorial": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "rights": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "operations": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5
                    }
                  },
                  "required": [
                    "reuse",
                    "sources",
                    "editorial",
                    "rights",
                    "operations"
                  ],
                  "additionalProperties": false
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "priority": {
                  "enum": [
                    1,
                    2,
                    3
                  ]
                },
                "weight": {
                  "enum": [
                    1,
                    2,
                    3
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "enum": [
                    "editorial_estimate",
                    "measured"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "name",
                "slug",
                "type",
                "parent_place_id",
                "dane_code",
                "administrative_identity_status",
                "score_inputs",
                "score",
                "priority",
                "weight",
                "reason",
                "confidence",
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "score_inputs",
          "score",
          "priority",
          "weight",
          "reason",
          "confidence",
          "unit_type",
          "dane_code",
          "places"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "as_of",
    "universe_version",
    "scope",
    "score_weights",
    "departments"
  ],
  "additionalProperties": false
}
