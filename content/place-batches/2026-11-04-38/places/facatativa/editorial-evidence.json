  "name": "Facatativá",
  "translations": {
    "es": {
      "title": "Facatativá, Cundinamarca",
      "location": "Cabecera de la provincia de Sabana Occidente, en el extremo occidental de la sabana de Bogotá.",
      "history": "Facatativá conserva referencias del territorio muisca y de los caminos que conectaron la sabana con el occidente del país. El Parque Arqueológico de Facatativá fue declarado Bien de Interés Cultural del ámbito nacional."
    },
    "en": {
      "title": "Facatativá, Cundinamarca",
      "location": "The seat of Sabana Occidente province, at the western edge of the Bogotá savanna.",
      "history": "Facatativá preserves traces of Muisca territory and of the routes that connected the savanna with western Colombia. Facatativá Archaeological Park was declared a National Cultural Heritage Asset."
    },
    "pt-BR": {
      "title": "Facatativá, Cundinamarca",
      "location": "Sede da província de Sabana Occidente, no extremo oeste da savana de Bogotá.",
      "history": "Facatativá preserva referências do território muisca e dos caminhos que conectaram a savana ao oeste do país. O Parque Arqueológico de Facatativá foi declarado Bem de Interesse Cultural de âmbito nacional."
    }
  },
