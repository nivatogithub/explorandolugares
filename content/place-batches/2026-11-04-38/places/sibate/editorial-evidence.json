  "translations": {
    "es": {
      "title": "Sibaté, Cundinamarca",
      "location": "Municipio de Cundinamarca, ubicado a 27 kilómetros al sur de Bogotá, en la Sabana Sur Occidental.",
      "history": "Aunque el nombre aparece en fuentes desde el siglo XVII, Sibaté se constituyó formalmente como municipio mediante ordenanzas de 1967 y 1968. Su historia local también conserva la memoria ferroviaria de la Estación Santa Isabel."
    },
    "en": {
      "title": "Sibaté, Cundinamarca",
      "location": "A Cundinamarca municipality located 27 kilometres south of Bogotá, in the southwestern southern savanna.",
      "history": "Although its name appears in sources from the 17th century, Sibaté was formally established as a municipality through ordinances of 1967 and 1968. Its local history also preserves the railway memory of Santa Isabel Station."
    },
    "pt-BR": {
      "title": "Sibaté, Cundinamarca",
      "location": "Município de Cundinamarca, localizado a 27 quilômetros ao sul de Bogotá, na Sabana Sul Ocidental.",
      "history": "Embora seu nome apareça em fontes desde o século XVII, Sibaté foi constituído formalmente como município por meio de ordenanças de 1967 e 1968. Sua história local também preserva a memória ferroviária da Estação Santa Isabel."
    }
