    "en": {
      "title": "Itagüí",
      "location": "Densely urbanized municipality south of Medellín in the Aburrá Valley, neighboring Medellín, Envigado, Sabaneta and La Estrella.",
      "history": "The settlement was founded in 1743 around a chapel and its first streets. In 1832 the creation of the District of Itagüí was approved, separating it from Envigado."
    },
    "pt-BR": {
      "title": "Itagüí",
      "location": "Município densamente urbanizado ao sul de Medellín, no Vale de Aburrá, vizinho de Medellín, Envigado, Sabaneta e La Estrella.",
      "history": "O povoado foi fundado em 1743 em torno de uma capela e de suas primeiras ruas. Em 1832 foi aprovada a criação do Distrito de Itagüí, então separado de Envigado."
