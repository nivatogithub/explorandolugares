  },
  "attractions": [
    {
      "name": "Johnny Cay",
      "description_es": "Un islote frente a la costa norte de San Andrés, con palmeras, playa y paisaje marino. Es un parque regional: el desembarque depende de las condiciones del mar y de las disposiciones de la autoridad ambiental.",
      "source_url": "https://colombia.travel/es/san-andres-isla/parque-regional-johnny-cay",
      "geolocation": {
        "latitude": 12.59945,
        "longitude": -81.69034,
        "source_url": "https://mapcarta.com/es/W169845001",
        "point_kind": "mapped_beach_reference_not_landing_pier",
        "checked_at": "2026-11-04"
      },
      "image_key": "attraction-01",
      "status": "research_confirmed_coordinates_pending"
    },
    {
      "name": "Rocky Cay",
      "description_es": "El pequeño cayo rocoso frente al sector de San Luis permite reconocer otro paisaje de la isla. La playa y el cayo no son el mismo punto; cualquier aproximación al cayo debe considerar las condiciones del mar.",
      "source_url": "https://colombia.travel/es/san-andres-isla/san-andres-sol-y-playa",
      "geolocation": null,
      "image_key": "attraction-02",
      "status": "research_confirmed_coordinates_pending"
    },
    {
      "name": "Primera Iglesia Bautista de La Loma",
      "description_es": "El templo de madera y su entorno en La Loma acercan al visitante a la tradición religiosa de la comunidad raizal. Su arquitectura y posición elevada ofrecen una visita distinta de las playas.",
      "source_url": "https://colombia.travel/es/san-andres-island/la-iglesia-bautista",
      "geolocation": {
        "latitude": 12.56191,
        "longitude": -81.71696,
        "source_url": "https://mapcarta.com/es/W169875625",
        "point_kind": "mapped_building_not_entrance",
        "checked_at": "2026-11-04"
      },
      "image_key": "attraction-03",
      "status": "research_confirmed_coordinates_pending"
    },
    {
      "name": "Parque Regional de Mangle Old Point",
      "description_es": "Un entorno de manglares en el costado oriental de la isla, en las bahías Hooker y Haynes. Es un lugar para conocer la vegetación costera y observar el paisaje sin alterar sus ecosistemas.",
      "source_url": "https://colombia.travel/es/san-andres-isla/parque-regional-de-mangle-old-point?page=1",
      "geolocation": null,
      "image_key": "attraction-04",
      "status": "research_confirmed_coordinates_pending"
    },
    {
      "name": "El Acuario y Haynes Cay",
      "description_es": "Rose Cay y Haynes Cay forman un paisaje de cayos y aguas someras conocido por las excursiones marinas. Las zonas de arena y las condiciones de acceso varían: no se presenta como un cruce peatonal garantizado.",
      "source_url": "https://colombia.travel/es/san-andres-isla",
