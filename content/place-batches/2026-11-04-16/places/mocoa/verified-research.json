  "editorial_locales": {
    "es": {
      "title": "Mocoa, senderos y cascadas del piedemonte",
      "intro": "Mocoa es un punto de partida para conocer bosques, quebradas y cascadas del piedemonte amazónico. Fin del Mundo y Ojo de Dios son sitios de visita administrada que requieren planear el acceso y las condiciones del recorrido.",
      "why_visit": [
        "Conocer cascadas y formaciones naturales en un entorno de bosque.",
        "Caminar por recorridos administrados con información previa de acceso.",
        "Combinar servicios de la ciudad con salidas de naturaleza."
      ]
    },
    "en": {
      "title": "Mocoa, foothill trails and waterfalls",
      "intro": "Mocoa is a starting point for exploring forests, streams and waterfalls in the Amazon foothills. Fin del Mundo and Ojo de Dios are managed visitor sites where access and route conditions should be checked in advance.",
      "why_visit": [
        "Discover waterfalls and natural formations in a forest setting.",
        "Walk managed routes with access information checked beforehand.",
        "Combine city services with nature outings."
      ]
    },
    "pt-BR": {
      "title": "Mocoa, trilhas e cachoeiras do sopé amazônico",
      "intro": "Mocoa é um ponto de partida para conhecer florestas, riachos e cachoeiras do sopé amazônico. Fin del Mundo e Ojo de Dios são locais de visita administrada: é preciso planejar o acesso e as condições do percurso.",
      "why_visit": [
        "Conhecer cachoeiras e formações naturais em meio à floresta.",
        "Percorrer trilhas administradas com informações prévias de acesso.",
        "Combinar os serviços da cidade com passeios de natureza."
      ]
    }
  },
