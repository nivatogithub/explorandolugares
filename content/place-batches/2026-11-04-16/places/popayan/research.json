  "editorial_locales": {
    "es": {
      "title": "Popayán, calles e historia de la Ciudad Blanca",
      "intro": "El centro histórico de Popayán reúne plazas, calles de fachadas blancas, templos y puentes que permiten recorrer distintas etapas de la ciudad. El parque Caldas y el puente del Humilladero son referencias para empezar a conocerlo.",
      "why_visit": [
        "Recorrer a pie el centro histórico y sus espacios públicos.",
        "Reconocer la arquitectura y los puentes característicos de Popayán.",
        "Complementar la visita autónoma con recorridos guiados documentados."
      ]
    },
    "en": {
      "title": "Popayán, streets and stories of the White City",
      "intro": "Popayán’s historic centre brings together squares, white-fronted streets, churches and bridges that reveal different chapters of the city’s history. Caldas Park and the Humilladero Bridge provide useful starting points.",
      "why_visit": [
        "Explore the historic centre and its public spaces on foot.",
