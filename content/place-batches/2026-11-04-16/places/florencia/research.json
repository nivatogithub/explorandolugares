    "es": {
      "title": "Florencia, entre piedemonte y ríos",
      "intro": "La capital del Caquetá conecta la vida urbana con el paisaje del piedemonte amazónico. Desde Puerto Arango se conoce la relación de Florencia con el río Orteguaza y se organizan recorridos fluviales.",
      "why_visit": [
        "Acercarse al paisaje ribereño del Orteguaza.",
        "Conocer el punto de encuentro entre la ciudad y las rutas fluviales del Caquetá.",
        "Encontrar servicios locales para organizar recorridos por la región."
      ]
    },
    "en": {
      "title": "Florencia, between foothills and rivers",
      "intro": "The capital of Caquetá connects city life with the Amazon foothills. Puerto Arango introduces visitors to Florencia’s relationship with the Orteguaza River and offers a starting point for organised river outings.",
      "why_visit": [
        "Discover the Orteguaza riverside landscape.",
        "Explore the connection between the city and Caquetá’s river routes.",
        "Find local services for planning regional outings."
      ]
    },
    "pt-BR": {
      "title": "Florencia, entre o sopé dos Andes e os rios",
      "intro": "A capital do Caquetá conecta a vida urbana à paisagem do sopé amazônico. Puerto Arango revela a relação de Florencia com o rio Orteguaza e é ponto de partida para passeios fluviais organizados.",
      "why_visit": [
        "Conhecer a paisagem ribeirinha do Orteguaza.",
        "Descobrir a ligação entre a cidade e as rotas fluviais do Caquetá.",
        "Encontrar serviços locais para organizar passeios pela região."
      ]
    }
  },
