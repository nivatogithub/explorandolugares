    "destination_story_translations": [
      {
        "story_block_id": 1000301,
        "locale": "es",
        "body": "Los caminos arrieros y la agricultura marcaron el crecimiento de Cocorná. Hoy sus ríos y montañas también sostienen una vocación de turismo de naturaleza."
      },
      {
        "story_block_id": 1000301,
        "locale": "en",
        "body": "Mule trails and farming shaped the growth of Cocorná. Its rivers and mountains now also support nature tourism."
      },
      {
        "story_block_id": 1000301,
        "locale": "pt-BR",
        "body": "Os caminhos dos tropeiros e a agricultura marcaram o crescimento de Cocorná. Hoje seus rios e montanhas também sustentam o turismo de natureza."
      }
    ],
