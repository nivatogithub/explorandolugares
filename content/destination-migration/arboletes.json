    "destination_story_translations": [
      {
        "story_block_id": 1000401,
        "locale": "es",
        "body": "La ganadería, la agricultura y el mar forman parte de la vida de Arboletes. Su volcán de lodo y las tradiciones del Caribe dan identidad a este rincón del Urabá."
      },
      {
        "story_block_id": 1000401,
        "locale": "en",
        "body": "Cattle farming, agriculture and the sea are part of daily life in Arboletes. Its mud volcano and Caribbean traditions shape the identity of this corner of Urabá."
      },
      {
        "story_block_id": 1000401,
        "locale": "pt-BR",
        "body": "A pecuária, a agricultura e o mar fazem parte da vida de Arboletes. Seu vulcão de lama e as tradições caribenhas dão identidade a este canto do Urabá."
      }
    ],
