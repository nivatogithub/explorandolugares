RewriteEngine On

# Canonical production host only; leave localhost/preprod unchanged.
RewriteCond %{HTTP_HOST} ^www\.explorandolugares\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://explorandolugares.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^explorandolugares\.com(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://explorandolugares.com%{REQUEST_URI} [R=301,L,NE]

# Read current publications on every sitemap request; internal rewrite only.
RewriteRule ^sitemap\.xml$ sitemap-live.php [L]

# Mantén una URL pública por página: el sitemap y los canonical usan la forma
# de directorio, mientras que muchas páginas enlazan históricamente index.html.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]

# Normaliza las rutas públicas de destinos con la barra final que declara el sitemap.
RewriteCond %{THE_REQUEST} \s/+((?:en/|pt-br/)?destinos/[a-z0-9-]+)(?:[?\s]) [NC]
RewriteRule ^((?:en/|pt-br/)?destinos/[a-z0-9-]+)$ /$1/ [R=301,L,NE]

# Panel privado de inteligencia de negocio e inversión.
# Resolver explícitamente el directorio: algunos hostings no incluyen index.php
# en DirectoryIndex y devuelven 403 antes de ejecutar la autenticación del portal.
RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/inversionistas/?$ admin/inversionistas.php [L,QSA]

# Inicio del buscador y solicitudes de reclamación de negocios.
RewriteRule ^reclamar-negocio/?$ reclamar-negocio.php [L,QSA]
RewriteRule ^negocios-locales/?$ business/index.php?lang=es [L,QSA]
RewriteRule ^en/negocios-locales/?$ business/index.php?lang=en [L,QSA]
RewriteRule ^pt-br/negocios-locales/?$ business/index.php?lang=pt-br [L,QSA]
RewriteRule ^cuenta/verificar-correo/?$ business/verify-email.php [L,QSA]
RewriteRule ^cuenta/espacio/?$ business/workspace.php [L,QSA]
RewriteRule ^negocios/recuperar-clave/?$ business/recover.php [L,QSA]
RewriteRule ^negocios/registro/?$ business/register.php [L,QSA]
RewriteRule ^suscripciones/continuar/?$ business/checkout.php [L,QSA]
RewriteRule ^negocios/acceso/?$ business/login.php [L,QSA]
RewriteRule ^negocios/portal/?$ business/dashboard.php [L,QSA]
RewriteRule ^negocios/salir/?$ business/logout.php [L,QSA]
RewriteRule ^negocios/cambiar-clave/?$ business/password.php [L,QSA]

# Páginas públicas de negocios por identificador público opaco.
RewriteRule ^negocios/perfil/([a-z][a-z0-9-]{2,69})/?$ negocio.php?alias=$1&idioma=es [L,QSA]
RewriteRule ^en/negocios/perfil/([a-z][a-z0-9-]{2,69})/?$ negocio.php?alias=$1&idioma=en [L,QSA]
RewriteRule ^pt-br/negocios/perfil/([a-z][a-z0-9-]{2,69})/?$ negocio.php?alias=$1&idioma=pt-BR [L,QSA]
RewriteRule ^negocios/([A-Fa-f0-9-]{16,64})/?$ negocio.php?id=$1&idioma=es [L,QSA,NC]
RewriteRule ^en/negocios/([A-Fa-f0-9-]{16,64})/?$ negocio.php?id=$1&idioma=en [L,QSA,NC]
RewriteRule ^pt-br/negocios/([A-Fa-f0-9-]{16,64})/?$ negocio.php?id=$1&idioma=pt-BR [L,QSA,NC]

# Slugs de destino: la URL pública no revela parámetros ni archivos de plantilla.
RewriteRule ^destinos/([a-z0-9-]+)(?:/index\.html)?/?$ destino.php?destino=$1&idioma=es [L,QSA,NC]
RewriteRule ^en/destinos/([a-z0-9-]+)(?:/index\.html)?/?$ destino.php?destino=$1&idioma=en [L,QSA,NC]
RewriteRule ^pt-br/destinos/([a-z0-9-]+)(?:/index\.html)?/?$ destino.php?destino=$1&idioma=pt-BR [L,QSA,NC]

# HTML must revalidate after a deployment; preserve caching for images/assets.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?|php)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
